generator client {
    provider = "prisma-client-js"

    output = "../src/generated/client"
}

datasource db {
    provider = "postgresql"
}

model Card {
    id           Int      @id @default(autoincrement())
    username     String   @unique
    name         String
    passwordHash String
    country      String
    email        String?
    number       String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    birthdate    DateTime
    column       Tastes[]
}

model Tastes {
    id        Int     @id @default(autoincrement())
    title     String
    isPrivate Boolean
    value     String
    card      Card[]
}
